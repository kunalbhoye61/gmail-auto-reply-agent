# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6

# draft_only | whitelist | all   (start with draft_only)
AUTO_SEND_MODE=draft_only
# Comma-separated emails or @domains, used when AUTO_SEND_MODE=whitelist
AUTO_SEND_WHITELIST=

ONLY_PROCESS_NEW_MAIL=true
MAX_EMAILS_PER_CYCLE=10
POLL_INTERVAL_SECONDS=60

# Who the agent writes as
USER_NAME=Kunal
USER_BIO=a B.Tech AI & Data Science Engineering student at K.K. Wagh Institute of Engineering, Nashik
